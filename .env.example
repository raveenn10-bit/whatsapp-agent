# WhatsApp AI Agent Configuration

# Port for the Web Dashboard and API
PORT=3000

# Google Gemini API Key (Recommended - Free tier available at https://aistudio.google.com)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# (Optional) OpenAI API Key if you prefer GPT-4o / GPT-4o-mini
OPENAI_API_KEY=

# AI Provider: 'gemini' or 'openai'
AI_PROVIDER=gemini

# Selected Gemini Model (gemini-2.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Admin Mobile / Owner Alert WhatsApp Number (format: 947XXXXXXXX)
OWNER_PHONE_NUMBER=94700000000

# Auto Read Incoming WhatsApp Messages (true / false)
AUTO_READ_MESSAGES=true

# Show Typing Presence Indicator before replying (true / false)
ENABLE_TYPING_INDICATOR=true

# Google Sheets Webhook URL (Optional for instant CRM sync)
GOOGLE_SHEET_WEBHOOK_URL=
